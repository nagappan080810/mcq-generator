# -----------------------------------------------------------------------------
# Dockerfile.vercel - Vercel container deployment
#
# Vercel detects a `Dockerfile.vercel` (or `Containerfile.vercel`) at the root
# and deploys the resulting OCI image as a Vercel Function (Container Image).
#
# Vercel routes HTTP traffic to port 80 by default, or the value of the
# $PORT environment variable. The app must serve HTTP and be stateless.
# -----------------------------------------------------------------------------

# ---- Stage 1: Build with JDK 21 ----
FROM eclipse-temurin:21-jdk-jammy AS builder

WORKDIR /build

COPY .mvn .mvn
COPY mvnw pom.xml ./
RUN ./mvnw -q -DskipTests dependency:go-offline || true

COPY src ./src
RUN ./mvnw -q clean package -DskipTests

# ---- Stage 2: Runtime with lightweight JRE ----
FROM eclipse-temurin:21-jre-jammy

RUN groupadd -r spring && useradd -r -g spring spring
WORKDIR /app

COPY --from=builder /build/target/mcq-generator-0.0.1-SNAPSHOT.jar app.jar

USER spring

CMD ["sh", "-c", "java -XX:+UseContainerSupport -Xmx480m -Xms256m -XX:MaxMetaspaceSize=256m -Dserver.port=${PORT:-80} -jar app.jar"]
