# -----------------------------------------------------------------------------
# Dockerfile.snapdeploy - Spring Boot app optimized for SnapDeploy free tier
#
# 512MB RAM limit: -Xmx380m leaves ~140MB for OS + Ollama client overhead.
# Uses JVM (not GraalVM) for simpler, more predictable builds on PaaS.
#
# Build:   docker build -f Dockerfile.snapdeploy -t mcq-snapdeploy .
# Run:     docker run -p 8080:8080 -e REDIS_URL=... mcq-snapdeploy
# Test:    curl http://localhost:8080/hello
# -----------------------------------------------------------------------------

# ---- Stage 1: Build with JDK 21 ----
FROM eclipse-temurin:21-jdk-jammy AS builder

WORKDIR /build

COPY .mvn .mvn
COPY mvnw pom.xml ./
RUN ./mvnw -q -DskipTests dependency:go-offline || true

COPY src ./src
RUN ./mvnw -q clean package -DskipTests

# ---- Stage 2: Runtime with lightweight JRE ----
FROM eclipse-temurin:21-jre-jammy

RUN groupadd -r spring && useradd -r -g spring spring
WORKDIR /app

COPY --from=builder /build/target/mcq-generator-0.0.1-SNAPSHOT.jar app.jar

RUN chown -R spring:spring /app

USER spring

ENV JAVA_OPTS="-Xmx380m -Xms128m -XX:MaxMetaspaceSize=128m -XX:+UseContainerSupport -XX:+UseG1GC -XX:MaxGCPauseMillis=50"
ENV PORT=8080

EXPOSE 8080

CMD ["sh", "-c", "java $JAVA_OPTS -Dserver.port=${PORT:-8080} -jar app.jar"]
